<?xml version="1.0" encoding="UTF-8"?>
<!-- Sports calendar (resources/lib/calendarwin.py): divisions/conferences on the left, the week's games on the right. -->
<window type="dialog">
	<defaultcontrol always="true">100</defaultcontrol>
	<coordinates><left>0</left><top>0</top></coordinates>
	<controls>
		<control type="image">
			<width>1920</width><height>1080</height>
			<texture>special://home/addons/plugin.video.sportshub/resources/media/bg.png</texture>
		</control>
		<control type="label">
			<left>100</left><top>36</top><width>1100</width><height>56</height>
			<font>font37</font>
			<label>[B]$INFO[Window.Property(title)][/B]   [COLOR B0FFFFFF]$INFO[Window.Property(range)][/COLOR]</label>
			<textcolor>FFFFFFFF</textcolor>
		</control>
		<control type="label">
			<left>100</left><top>500</top><width>1720</width><height>60</height>
			<font>font30_title</font><align>center</align>
			<label>$INFO[Window.Property(message)]</label>
			<textcolor>B0FFFFFF</textcolor>
			<visible>!String.IsEmpty(Window.Property(message))</visible>
		</control>
		<!-- week buttons -->
		<control type="button" id="301">
			<left>1240</left><top>36</top><width>280</width><height>60</height>
			<label>‹  Previous week</label><font>font25_title</font><align>center</align><aligny>center</aligny>
			<texturefocus border="12" colordiffuse="FF33405E">special://home/addons/plugin.video.sportshub/resources/media/card.png</texturefocus>
			<texturenofocus border="12" colordiffuse="FF1C2438">special://home/addons/plugin.video.sportshub/resources/media/card.png</texturenofocus>
			<textcolor>D0FFFFFF</textcolor><focusedcolor>FFFFFFFF</focusedcolor>
			<onright>302</onright><ondown>100</ondown>
		</control>
		<control type="button" id="302">
			<left>1540</left><top>36</top><width>280</width><height>60</height>
			<label>Next week  ›</label><font>font25_title</font><align>center</align><aligny>center</aligny>
			<texturefocus border="12" colordiffuse="FF33405E">special://home/addons/plugin.video.sportshub/resources/media/card.png</texturefocus>
			<texturenofocus border="12" colordiffuse="FF1C2438">special://home/addons/plugin.video.sportshub/resources/media/card.png</texturenofocus>
			<textcolor>D0FFFFFF</textcolor><focusedcolor>FFFFFFFF</focusedcolor>
			<onleft>301</onleft><ondown>200</ondown>
		</control>
		<!-- groups -->
		<control type="list" id="100">
			<left>90</left><top>130</top><width>480</width><height>920</height>
			<onright>200</onright><onup>301</onup>
			<scrolltime tween="cubic" easing="out">150</scrolltime>
			<itemlayout width="480" height="68">
				<control type="label">
					<left>20</left><top>0</top><width>360</width><height>68</height><aligny>center</aligny>
					<font>font27</font><label>$INFO[ListItem.Label]</label><textcolor>B0FFFFFF</textcolor>
				</control>
				<control type="label">
					<left>380</left><top>0</top><width>80</width><height>68</height><aligny>center</aligny><align>right</align>
					<font>font23_narrow</font><label>$INFO[ListItem.Property(count)]</label><textcolor>80FFFFFF</textcolor>
				</control>
			</itemlayout>
			<focusedlayout width="480" height="68">
				<control type="image">
					<left>0</left><top>4</top><width>480</width><height>60</height>
					<texture border="12" colordiffuse="FF33405E">special://home/addons/plugin.video.sportshub/resources/media/card.png</texture>
					<visible>Control.HasFocus(100)</visible>
				</control>
				<control type="image">
					<left>0</left><top>4</top><width>6</width><height>60</height>
					<texture colordiffuse="FFE0162B">special://home/addons/plugin.video.sportshub/resources/media/white.png</texture>
					<visible>!Control.HasFocus(100)</visible>
				</control>
				<control type="label">
					<left>20</left><top>0</top><width>360</width><height>68</height><aligny>center</aligny>
					<font>font27</font><label>[B]$INFO[ListItem.Label][/B]</label><textcolor>FFFFFFFF</textcolor>
				</control>
				<control type="label">
					<left>380</left><top>0</top><width>80</width><height>68</height><aligny>center</aligny><align>right</align>
					<font>font23_narrow</font><label>$INFO[ListItem.Property(count)]</label><textcolor>C0FFFFFF</textcolor>
				</control>
			</focusedlayout>
		</control>
		<!-- games -->
		<control type="list" id="200">
			<left>600</left><top>130</top><width>1240</width><height>920</height>
			<onleft>100</onleft><onup>302</onup>
			<scrolltime tween="cubic" easing="out">150</scrolltime>
			<itemlayout width="1240" height="100">
				<control type="label">
					<left>24</left><top>10</top><width>230</width><height>40</height>
					<font>font25_title</font><label>$INFO[ListItem.Property(day)]</label><textcolor>D8FFFFFF</textcolor>
				</control>
				<control type="label">
					<left>24</left><top>50</top><width>230</width><height>36</height>
					<font>font23_narrow</font><label>$INFO[ListItem.Property(time)]</label><textcolor>90FFFFFF</textcolor>
				</control>
				<control type="image">
					<left>270</left><top>18</top><width>64</width><height>64</height><aspectratio>keep</aspectratio>
					<texture background="true">$INFO[ListItem.Property(away_logo)]</texture>
				</control>
				<control type="label">
					<left>440</left><top>0</top><width>380</width><height>100</height><aligny>center</aligny>
					<font>font30_title</font><label>[B]$INFO[ListItem.Label][/B]</label><textcolor>D8FFFFFF</textcolor>
				</control>
				<control type="image">
					<left>350</left><top>18</top><width>64</width><height>64</height><aspectratio>keep</aspectratio>
					<texture background="true">$INFO[ListItem.Property(home_logo)]</texture>
				</control>
				<control type="label">
					<left>830</left><top>10</top><width>390</width><height>40</height><align>right</align>
					<font>font25_title</font><label>$INFO[ListItem.Property(status)]</label><textcolor>D8FFFFFF</textcolor>
				</control>
				<control type="label">
					<left>830</left><top>50</top><width>390</width><height>36</height><align>right</align>
					<font>font23_narrow</font><label>$INFO[ListItem.Property(network)]</label><textcolor>90FFFFFF</textcolor>
				</control>
				<control type="image">
					<left>0</left><top>12</top><width>6</width><height>76</height>
					<texture colordiffuse="FFE0162B">special://home/addons/plugin.video.sportshub/resources/media/white.png</texture>
					<visible>!String.IsEmpty(ListItem.Property(mine))</visible>
				</control>
			</itemlayout>
			<focusedlayout width="1240" height="100">
				<control type="image">
					<left>0</left><top>4</top><width>1240</width><height>92</height>
					<texture border="12" colordiffuse="FF33405E">special://home/addons/plugin.video.sportshub/resources/media/card.png</texture>
					<visible>Control.HasFocus(200)</visible>
				</control>
				<control type="label">
					<left>24</left><top>10</top><width>230</width><height>40</height>
					<font>font25_title</font><label>$INFO[ListItem.Property(day)]</label><textcolor>FFFFFFFF</textcolor>
				</control>
				<control type="label">
					<left>24</left><top>50</top><width>230</width><height>36</height>
					<font>font23_narrow</font><label>$INFO[ListItem.Property(time)]</label><textcolor>D0FFFFFF</textcolor>
				</control>
				<control type="image">
					<left>270</left><top>18</top><width>64</width><height>64</height><aspectratio>keep</aspectratio>
					<texture background="true">$INFO[ListItem.Property(away_logo)]</texture>
				</control>
				<control type="label">
					<left>440</left><top>0</top><width>380</width><height>100</height><aligny>center</aligny>
					<font>font30_title</font><label>[B]$INFO[ListItem.Label][/B]</label><textcolor>FFFFFFFF</textcolor>
				</control>
				<control type="image">
					<left>350</left><top>18</top><width>64</width><height>64</height><aspectratio>keep</aspectratio>
					<texture background="true">$INFO[ListItem.Property(home_logo)]</texture>
				</control>
				<control type="label">
					<left>830</left><top>10</top><width>390</width><height>40</height><align>right</align>
					<font>font25_title</font><label>$INFO[ListItem.Property(status)]</label><textcolor>FFFFFFFF</textcolor>
				</control>
				<control type="label">
					<left>830</left><top>50</top><width>390</width><height>36</height><align>right</align>
					<font>font23_narrow</font><label>$INFO[ListItem.Property(network)]</label><textcolor>D0FFFFFF</textcolor>
				</control>
				<control type="image">
					<left>0</left><top>12</top><width>6</width><height>76</height>
					<texture colordiffuse="FFE0162B">special://home/addons/plugin.video.sportshub/resources/media/white.png</texture>
					<visible>!String.IsEmpty(ListItem.Property(mine))</visible>
				</control>
			</focusedlayout>
		</control>
	</controls>
</window>
