<?xml version="1.0" encoding="UTF-8"?>
<!-- Browse one category (resources/lib/browse.py): channels on now, then shows and movies on your services. -->
<window type="dialog">
	<defaultcontrol always="true">100</defaultcontrol>
	<coordinates><left>0</left><top>0</top></coordinates>
	<controls>
		<control type="image">
			<width>1920</width><height>1080</height>
			<texture>special://home/addons/plugin.video.sportshub/resources/media/bg.png</texture>
		</control>
		<control type="label">
			<left>100</left><top>36</top><width>1200</width><height>56</height>
			<font>font37</font>
			<label>[B]$INFO[Window.Property(title)][/B]</label>
			<textcolor>FFFFFFFF</textcolor>
		</control>
		<control type="label">
			<left>1000</left><top>48</top><width>820</width><height>40</height>
			<font>font23_narrow</font>
			<align>right</align>
			<label>OK  watch or details        $INFO[System.Time]</label>
			<textcolor>A0FFFFFF</textcolor>
		</control>
		<control type="label">
			<left>100</left><top>480</top><width>1720</width><height>60</height>
			<font>font30_title</font>
			<align>center</align>
			<label>Nothing in this category right now</label>
			<textcolor>B0FFFFFF</textcolor>
			<visible>!String.IsEmpty(Window.Property(empty))</visible>
		</control>

		<!-- live now -->
		<control type="label">
			<left>100</left><top>112</top><width>1200</width><height>36</height>
			<font>font25_title</font>
			<label>LIVE NOW   [COLOR A0FFFFFF]$INFO[Window.Property(live_count)][/COLOR]</label>
			<textcolor>FFFFFFFF</textcolor>
			<visible>Integer.IsGreater(Container(100).NumItems,0) | Integer.IsGreater(Container(110).NumItems,0)</visible>
		</control>
		<control type="list" id="100">
			<left>90</left><top>150</top><width>1760</width><height>200</height>
			<orientation>horizontal</orientation>
			<ondown condition="Integer.IsGreater(Container(200).NumItems,0)">200</ondown>
			<ondown condition="!Integer.IsGreater(Container(200).NumItems,0)">300</ondown>
			<scrolltime tween="cubic" easing="out">200</scrolltime>
			<visible>Integer.IsGreater(Container(100).NumItems,0)</visible>
			<itemlayout width="420" height="200">
				<control type="image">
					<left>10</left><top>10</top><width>400</width><height>180</height>
					<texture border="12" colordiffuse="FF222B40">special://home/addons/plugin.video.sportshub/resources/media/card.png</texture>
				</control>
				<control type="image">
					<left>28</left><top>26</top><width>120</width><height>70</height>
					<aspectratio>keep</aspectratio>
					<texture background="true">$INFO[ListItem.Art(thumb)]</texture>
				</control>
				<control type="label">
					<left>164</left><top>26</top><width>230</width><height>70</height>
					<font>font23_narrow</font><wrapmultiline>true</wrapmultiline>
					<label>$INFO[ListItem.Label]</label><textcolor>C0FFFFFF</textcolor>
				</control>
				<control type="label">
					<left>28</left><top>104</top><width>366</width><height>36</height>
					<font>font27</font>
					<label>[B]$INFO[ListItem.Property(now)][/B]</label><textcolor>FFFFFFFF</textcolor>
				</control>
				<control type="label">
					<left>28</left><top>144</top><width>366</width><height>30</height>
					<font>font23_narrow</font>
					<label>$INFO[ListItem.Property(meta)]</label><textcolor>A0FFFFFF</textcolor>
				</control>
			</itemlayout>
			<focusedlayout width="420" height="200">
				<control type="image">
					<left>10</left><top>10</top><width>400</width><height>180</height>
					<texture border="12" colordiffuse="FF33405E">special://home/addons/plugin.video.sportshub/resources/media/card.png</texture>
				</control>
				<control type="image">
					<left>4</left><top>4</top><width>412</width><height>192</height>
					<texture border="16">special://home/addons/plugin.video.sportshub/resources/media/card_focus.png</texture>
					<visible>Control.HasFocus(100)</visible>
				</control>
				<control type="image">
					<left>28</left><top>26</top><width>120</width><height>70</height>
					<aspectratio>keep</aspectratio>
					<texture background="true">$INFO[ListItem.Art(thumb)]</texture>
				</control>
				<control type="label">
					<left>164</left><top>26</top><width>230</width><height>70</height>
					<font>font23_narrow</font><wrapmultiline>true</wrapmultiline>
					<label>$INFO[ListItem.Label]</label><textcolor>FFFFFFFF</textcolor>
				</control>
				<control type="label">
					<left>28</left><top>104</top><width>366</width><height>36</height>
					<font>font27</font><scroll>true</scroll>
					<label>[B]$INFO[ListItem.Property(now)][/B]</label><textcolor>FFFFFFFF</textcolor>
				</control>
				<control type="label">
					<left>28</left><top>144</top><width>366</width><height>30</height>
					<font>font23_narrow</font>
					<label>$INFO[ListItem.Property(meta)]</label><textcolor>D0FFFFFF</textcolor>
				</control>
			</focusedlayout>
		</control>

		<!-- live now as a full-screen grid, for categories with no shows or movies -->
		<control type="panel" id="110">
			<left>90</left><top>150</top><width>1760</width><height>900</height>
			<orientation>vertical</orientation>
			<scrolltime tween="cubic" easing="out">200</scrolltime>
			<visible>Integer.IsGreater(Container(110).NumItems,0)</visible>
			<itemlayout width="420" height="200">
				<control type="image">
					<left>10</left><top>10</top><width>400</width><height>180</height>
					<texture border="12" colordiffuse="FF222B40">special://home/addons/plugin.video.sportshub/resources/media/card.png</texture>
				</control>
				<control type="image">
					<left>28</left><top>26</top><width>120</width><height>70</height>
					<aspectratio>keep</aspectratio>
					<texture background="true">$INFO[ListItem.Art(thumb)]</texture>
				</control>
				<control type="label">
					<left>164</left><top>26</top><width>230</width><height>70</height>
					<font>font23_narrow</font><wrapmultiline>true</wrapmultiline>
					<label>$INFO[ListItem.Label]</label><textcolor>C0FFFFFF</textcolor>
				</control>
				<control type="label">
					<left>28</left><top>104</top><width>366</width><height>36</height>
					<font>font27</font>
					<label>[B]$INFO[ListItem.Property(now)][/B]</label><textcolor>FFFFFFFF</textcolor>
				</control>
				<control type="label">
					<left>28</left><top>144</top><width>366</width><height>30</height>
					<font>font23_narrow</font>
					<label>$INFO[ListItem.Property(meta)]</label><textcolor>A0FFFFFF</textcolor>
				</control>
			</itemlayout>
			<focusedlayout width="420" height="200">
				<control type="image">
					<left>10</left><top>10</top><width>400</width><height>180</height>
					<texture border="12" colordiffuse="FF33405E">special://home/addons/plugin.video.sportshub/resources/media/card.png</texture>
				</control>
				<control type="image">
					<left>4</left><top>4</top><width>412</width><height>192</height>
					<texture border="16">special://home/addons/plugin.video.sportshub/resources/media/card_focus.png</texture>
					<visible>Control.HasFocus(110)</visible>
				</control>
				<control type="image">
					<left>28</left><top>26</top><width>120</width><height>70</height>
					<aspectratio>keep</aspectratio>
					<texture background="true">$INFO[ListItem.Art(thumb)]</texture>
				</control>
				<control type="label">
					<left>164</left><top>26</top><width>230</width><height>70</height>
					<font>font23_narrow</font><wrapmultiline>true</wrapmultiline>
					<label>$INFO[ListItem.Label]</label><textcolor>FFFFFFFF</textcolor>
				</control>
				<control type="label">
					<left>28</left><top>104</top><width>366</width><height>36</height>
					<font>font27</font><scroll>true</scroll>
					<label>[B]$INFO[ListItem.Property(now)][/B]</label><textcolor>FFFFFFFF</textcolor>
				</control>
				<control type="label">
					<left>28</left><top>144</top><width>366</width><height>30</height>
					<font>font23_narrow</font>
					<label>$INFO[ListItem.Property(meta)]</label><textcolor>D0FFFFFF</textcolor>
				</control>
			</focusedlayout>
		</control>

		<!-- shows -->
		<control type="label">
			<left>100</left><top>372</top><width>1200</width><height>36</height>
			<font>font25_title</font>
			<label>SHOWS ON YOUR SERVICES</label>
			<textcolor>FFFFFFFF</textcolor>
			<visible>Integer.IsGreater(Container(200).NumItems,0)</visible>
		</control>
		<control type="label">
			<left>100</left><top>372</top><width>1200</width><height>36</height>
			<font>font25_title</font>
			<label>Finding shows and movies on your services…</label>
			<textcolor>A0FFFFFF</textcolor>
			<visible>!String.IsEmpty(Window.Property(loading)) + String.IsEmpty(Window.Property(liveonly))</visible>
		</control>
		<control type="list" id="200">
			<left>90</left><top>410</top><width>1760</width><height>290</height>
			<orientation>horizontal</orientation>
			<onup>100</onup>
			<ondown>300</ondown>
			<scrolltime tween="cubic" easing="out">200</scrolltime>
			<visible>Integer.IsGreater(Container(200).NumItems,0)</visible>
			<itemlayout width="200" height="290">
				<control type="image">
					<left>8</left><top>8</top><width>184</width><height>274</height>
					<aspectratio>scale</aspectratio>
					<texture background="true">$INFO[ListItem.Art(thumb)]</texture>
				</control>
			</itemlayout>
			<focusedlayout width="200" height="290">
				<control type="image">
					<left>8</left><top>8</top><width>184</width><height>274</height>
					<aspectratio>scale</aspectratio>
					<texture background="true">$INFO[ListItem.Art(thumb)]</texture>
				</control>
				<control type="image">
					<left>2</left><top>2</top><width>196</width><height>286</height>
					<texture border="16">special://home/addons/plugin.video.sportshub/resources/media/card_focus.png</texture>
					<visible>Control.HasFocus(200)</visible>
				</control>
			</focusedlayout>
		</control>

		<!-- movies -->
		<control type="label">
			<left>100</left><top>712</top><width>1200</width><height>36</height>
			<font>font25_title</font>
			<label>MOVIES ON YOUR SERVICES</label>
			<textcolor>FFFFFFFF</textcolor>
			<visible>Integer.IsGreater(Container(300).NumItems,0)</visible>
		</control>
		<control type="list" id="300">
			<left>90</left><top>750</top><width>1760</width><height>290</height>
			<orientation>horizontal</orientation>
			<onup condition="Integer.IsGreater(Container(200).NumItems,0)">200</onup>
			<onup condition="!Integer.IsGreater(Container(200).NumItems,0)">100</onup>
			<scrolltime tween="cubic" easing="out">200</scrolltime>
			<visible>Integer.IsGreater(Container(300).NumItems,0)</visible>
			<itemlayout width="200" height="290">
				<control type="image">
					<left>8</left><top>8</top><width>184</width><height>274</height>
					<aspectratio>scale</aspectratio>
					<texture background="true">$INFO[ListItem.Art(thumb)]</texture>
				</control>
			</itemlayout>
			<focusedlayout width="200" height="290">
				<control type="image">
					<left>8</left><top>8</top><width>184</width><height>274</height>
					<aspectratio>scale</aspectratio>
					<texture background="true">$INFO[ListItem.Art(thumb)]</texture>
				</control>
				<control type="image">
					<left>2</left><top>2</top><width>196</width><height>286</height>
					<texture border="16">special://home/addons/plugin.video.sportshub/resources/media/card_focus.png</texture>
					<visible>Control.HasFocus(300)</visible>
				</control>
			</focusedlayout>
		</control>
	</controls>
</window>
