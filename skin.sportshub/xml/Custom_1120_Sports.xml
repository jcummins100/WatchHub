<?xml version="1.0" encoding="UTF-8"?>
<!-- WatchHub Sports (header ball icon): Home's look with the sports rows. Built from Home.xml. -->
<!-- Sports Hub home: cinematic backdrop + hero for the focused item + horizontal rails. -->
<window id="1120" type="window">
	<defaultcontrol always="true">9000</defaultcontrol>
	<backgroundcolor>background</backgroundcolor>
	<controls>
		<include>DefaultBackground</include>

		<!-- ============================ background ============================ -->
		<control type="image">
			<include>FullScreenDimensions</include>
			<texture>sportshub/bg.png</texture>
			<visible>!Player.HasVideo</visible>
		</control>

