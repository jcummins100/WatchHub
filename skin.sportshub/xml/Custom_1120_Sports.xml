				<param name="onclick" value="RunPlugin($INFO[ListItem.FileNameAndPath])"/>
				<param name="layout" value="SH_CardChannelAny"/>
				<param name="item_width" value="416"/>
			</include>
			<include content="SH_Rail">
				<param name="list_id" value="9200"/>
				<param name="row_top" value="376"/>
