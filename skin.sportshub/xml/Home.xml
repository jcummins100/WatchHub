			<texture background="true" colordiffuse="22FFFFFF">$VAR[SH_HeroLogo]</texture>
			<visible>!Player.HasVideo</visible>
		</control>
		<control type="image">
			<left>560</left>
			<top>0</top>
			<width>1360</width>
			<height>556</height>
			<aspectratio align="right" aligny="top">scale</aspectratio>
			<fadetime>500</fadetime>
			<texture background="true" colordiffuse="C8FFFFFF">$VAR[SH_Backdrop]</texture>
