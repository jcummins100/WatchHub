		<!-- ============================ hero band (painted over the scrolling rails) ============================ -->
		<control type="image">
			<left>0</left>
			<top>0</top>
			<width>1920</width>
			<height>556</height>
			<texture>sportshub/bg.png</texture>
			<aspectratio align="left" aligny="top">scale</aspectratio>
			<visible>!Player.HasVideo</visible>
		</control>
		<control type="image">
			<left>1180</left>
			<top>90</top>
			<width>620</width>
			<height>380</height>
			<aspectratio align="center" aligny="center">keep</aspectratio>
