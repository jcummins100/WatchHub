	<!-- ====================== card: game (two team logos + score) ====================== -->
	<!-- Kodi's own "More..." item at the end of a full row, drawn as a "See all" card -->
	<include name="SH_CardSeeAll">
		<definition>
			<control type="group">
				<visible>String.IsEmpty(ListItem.Property(kind))</visible>
				<left>16</left>
				<top>16</top>
				<width>$PARAM[width]</width>
				<height>216</height>
