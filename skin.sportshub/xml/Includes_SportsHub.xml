	<!-- ====================== static rail: the rest of Kodi ====================== -->
	<include name="SH_RailStatic">
		<param name="prev1">9700</param>
		<param name="prev2">9500</param>
		<param name="prev3">9400</param>
		<definition>
			<control type="group">
				<top>$PARAM[row_top]</top>
				<height>376</height>
				<control type="label">
					<left>100</left>
					<top>0</top>
					<width>1000</width>
					<height>40</height>
					<font>font25_title</font>
					<label>[B]$PARAM[header][/B]</label>
					<textcolor>FFFFFFFF</textcolor>
				</control>
				<control type="panel" id="$PARAM[list_id]">
					<left>84</left>
					<top>44</top>
					<right>0</right>
					<height>312</height>
					<orientation>horizontal</orientation>
					<onleft>noop</onleft>
					<onright>noop</onright>
					<onup condition="Control.IsVisible($PARAM[prev1])">$PARAM[prev1]</onup>
					<onup condition="!Control.IsVisible($PARAM[prev1]) + Control.IsVisible($PARAM[prev2])">$PARAM[prev2]</onup>
					<onup condition="!Control.IsVisible($PARAM[prev1]) + !Control.IsVisible($PARAM[prev2])">$PARAM[prev3]</onup>
					<ondown>noop</ondown>
					<scrolltime tween="cubic" easing="out">300</scrolltime>
					<itemlayout width="416" height="312">
						<include content="SH_CardSport">
							<param name="focused" value="false"/>
						</include>
					</itemlayout>
					<focusedlayout width="416" height="312">
						<control type="group">
							<depth>DepthContentPopout</depth>
							<animation effect="zoom" start="100" end="106" time="160" tween="sine" easing="out" center="216,128">Focus</animation>
							<animation effect="zoom" start="106" end="100" time="160" tween="sine" easing="out" center="216,128">UnFocus</animation>
							<include content="SH_CardSport">
								<param name="focused" value="true"/>
							</include>
						</control>
					</focusedlayout>
					<content>
						<item>
							<label>Live TV</label>
							<property name="meta">Kodi's TV guide and channels</property>
							<property name="color">FF2C3E66</property>
							<onclick>ActivateWindow(TVChannels)</onclick>
							<visible>System.HasPVRAddon</visible>
						</item>
						<item>
							<label>WatchHub menu</label>
							<property name="meta">Everything, as a list</property>
							<property name="color">FF234F3E</property>
							<onclick>ActivateWindow(Videos,plugin://plugin.video.sportshub/,return)</onclick>
						</item>
						<item>
							<label>TV Guide</label>
							<property name="meta">Every free channel - what's on now and later</property>
							<property name="color">FF8A1F2E</property>
							<onclick>SetProperty(sh_ui_request,plugin://plugin.video.sportshub/?action=guide,home)</onclick>
						</item>
						<item>
							<label>By sport</label>
							<property name="meta">Football, basketball, golf... what's on now</property>
							<property name="color">FF6E3A1F</property>
							<onclick>ActivateWindow(Videos,plugin://plugin.video.sportshub/?action=sports,return)</onclick>
						</item>
						<item>
							<label>Your apps</label>
							<property name="meta">Every streaming app on this Shield</property>
							<property name="color">FF3B2F6E</property>
							<onclick>ActivateWindow(Videos,plugin://plugin.video.sportshub/?action=apps,return)</onclick>
						</item>
						<item>
							<label>Videos</label>
							<property name="meta">Files, sources and your library</property>
							<property name="color">FF3A2F5C</property>
							<onclick>ActivateWindow(Videos,root,return)</onclick>
						</item>
						<item>
							<label>Add-ons</label>
							<property name="meta">Installed Kodi add-ons</property>
							<property name="color">FF5C3A2F</property>
							<onclick>ActivateWindow(1100)</onclick>
						</item>
						<item>
							<label>Settings</label>
							<property name="meta">Kodi settings</property>
							<property name="color">FF3B3F4A</property>
							<onclick>ActivateWindow(settings)</onclick>
						</item>
						<item>
							<label>Classic Kodi look</label>
							<property name="meta">Switch back to the Estuary skin</property>
							<property name="color">FF2B4A5E</property>
							<onclick>RunPlugin(plugin://plugin.video.sportshub/?action=skin&amp;name=skin.estuary)</onclick>
						</item>
					</content>
				</control>
			</control>
		</definition>
	</include>
