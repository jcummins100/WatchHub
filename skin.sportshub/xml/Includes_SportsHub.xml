	<!-- ====================== a rail: header + one horizontal row of cards ====================== -->
	<include name="SH_Rail">
		<param name="limit">25</param>
		<param name="item_width">416</param>
		<param name="prev1">700</param>
		<param name="prev2">700</param>
		<param name="prev3">700</param>
		<param name="next1">9600</param>
		<param name="next2">9600</param>
		<param name="next3">9600</param>
		<param name="onback">noop</param>
		<definition>
			<control type="group">
				<top>$PARAM[row_top]</top>
				<height>376</height>
				<control type="label">
					<left>100</left>
					<top>0</top>
					<width>1000</width>
					<height>40</height>
					<font>font25_title</font>
					<label>[B]$PARAM[header][/B]</label>
					<textcolor>FFFFFFFF</textcolor>
					<shadowcolor>AA000000</shadowcolor>
				</control>
				<control type="label">
					<left>100</left>
					<top>60</top>
					<width>1000</width>
					<height>40</height>
					<font>font27</font>
					<label>Nothing right now</label>
					<textcolor>60FFFFFF</textcolor>
					<visible>!Integer.IsGreater(Container($PARAM[list_id]).NumItems,0) + !Container($PARAM[list_id]).IsUpdating</visible>
				</control>
				<include content="BusyListSpinner">
					<param name="list_id" value="$PARAM[list_id]"/>
					<param name="posy" value="120"/>
				</include>
				<control type="panel" id="$PARAM[list_id]">
					<left>84</left>
					<top>44</top>
					<right>0</right>
					<height>312</height>
					<orientation>horizontal</orientation>
					<onleft>noop</onleft>
					<onright>noop</onright>
					<onup condition="Control.IsVisible($PARAM[prev1])">$PARAM[prev1]</onup>
					<onup condition="!Control.IsVisible($PARAM[prev1]) + Control.IsVisible($PARAM[prev2])">$PARAM[prev2]</onup>
					<onup condition="!Control.IsVisible($PARAM[prev1]) + !Control.IsVisible($PARAM[prev2])">$PARAM[prev3]</onup>
					<ondown condition="Control.IsVisible($PARAM[next1])">$PARAM[next1]</ondown>
					<ondown condition="!Control.IsVisible($PARAM[next1]) + Control.IsVisible($PARAM[next2])">$PARAM[next2]</ondown>
					<ondown condition="!Control.IsVisible($PARAM[next1]) + !Control.IsVisible($PARAM[next2])">$PARAM[next3]</ondown>
					<visible>Integer.IsGreater(Container($PARAM[list_id]).NumItems,0) | Container($PARAM[list_id]).IsUpdating</visible>
					<!-- Kodi appends its own "More..." item (no card kind) when a row hits its limit: open the full list -->
					<!-- info pages and the TV Guide: hand the request straight to WatchHub's service (no Python start-up per click) -->
					<onclick condition="String.Contains(ListItem.FileNameAndPath,action=info) | String.Contains(ListItem.FileNameAndPath,action=guide) | String.Contains(ListItem.FileNameAndPath,action=browse&amp;)">SetProperty(sh_ui_request,$INFO[ListItem.FileNameAndPath],home)</onclick>
					<onclick condition="!String.IsEmpty(ListItem.Property(kind)) + !String.IsEqual(ListItem.Property(kind),guide) + !String.Contains(ListItem.FileNameAndPath,action=info) + !String.Contains(ListItem.FileNameAndPath,action=browse&amp;)">$PARAM[onclick]</onclick>
					<onclick condition="String.IsEmpty(ListItem.Property(kind))">ActivateWindow(Videos,$INFO[ListItem.FolderPath],return)</onclick>
					<onback>$PARAM[onback]</onback>
					<scrolltime tween="cubic" easing="out">300</scrolltime>
					<preloaditems>2</preloaditems>
					<itemlayout width="$PARAM[item_width]" height="312">
						<control type="group">
							<visible>!String.IsEmpty(ListItem.Property(kind))</visible>
							<include content="$PARAM[layout]">
								<param name="focused" value="false"/>
							</include>
						</control>
						<include content="SH_CardSeeAll">
							<param name="width" value="$PARAM[item_width]"/>
							<param name="focused" value="false"/>
						</include>
					</itemlayout>
					<focusedlayout width="$PARAM[item_width]" height="312">
						<control type="group">
							<depth>DepthContentPopout</depth>
							<animation effect="zoom" start="100" end="106" time="160" tween="sine" easing="out" center="216,128">Focus</animation>
							<animation effect="zoom" start="106" end="100" time="160" tween="sine" easing="out" center="216,128">UnFocus</animation>
							<control type="group">
								<visible>!String.IsEmpty(ListItem.Property(kind))</visible>
								<include content="$PARAM[layout]">
									<param name="focused" value="true"/>
								</include>
							</control>
							<include content="SH_CardSeeAll">
								<param name="width" value="$PARAM[item_width]"/>
								<param name="focused" value="true"/>
							</include>
						</control>
					</focusedlayout>
					<content target="videos" limit="$PARAM[limit]">$PARAM[content_path]</content>
				</control>
			</control>
		</definition>
	</include>

