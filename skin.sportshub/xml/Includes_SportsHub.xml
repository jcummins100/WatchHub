	<!-- live rows: channel cards, or a plain tile (the TV Guide card, messages) -->
	<include name="SH_CardChannelAny">
		<definition>
			<control type="group">
				<visible>!String.IsEqual(ListItem.Property(kind),guide) + !String.IsEqual(ListItem.Property(kind),tile)</visible>
				<include content="SH_CardChannel">
					<param name="focused" value="$PARAM[focused]"/>
				</include>
			</control>
			<control type="group">
				<visible>String.IsEqual(ListItem.Property(kind),guide) | String.IsEqual(ListItem.Property(kind),tile)</visible>
				<include content="SH_CardSport">
					<param name="focused" value="$PARAM[focused]"/>
				</include>
			</control>
		</definition>
	</include>

	<!-- games row: matchup cards, or a plain tile for messages ("Live scores are off") -->
	<include name="SH_CardGameAny">
		<definition>
			<control type="group">
				<visible>!String.IsEqual(ListItem.Property(kind),tile)</visible>
				<include content="SH_CardGame">
