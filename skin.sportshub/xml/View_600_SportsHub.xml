<?xml version="1.0" encoding="UTF-8"?>
<!-- Sports Hub card grid for every Sports Hub sub-screen: a hero header for the focused item and a 4-wide grid of cards. -->
<includes>
	<include name="View_600_SportsHub">
		<control type="group">
			<visible>Control.IsVisible(600)</visible>
			<animation effect="fade" time="200">VisibleChange</animation>
			<control type="image">
				<include>FullScreenDimensions</include>
				<texture>sportshub/bg.png</texture>
			</control>
			<!-- header -->
			<control type="label">
				<left>100</left>
				<top>42</top>
				<width>900</width>
				<height>50</height>
				<font>font37</font>
				<label>[B]WATCH[/B]HUB  [COLOR 80FFFFFF]/  $INFO[Container.PluginCategory][/COLOR]</label>
				<textcolor>FFFFFFFF</textcolor>
				<visible>!String.IsEmpty(Container.PluginCategory)</visible>
			</control>
			<control type="label">
				<left>100</left>
				<top>42</top>
				<width>900</width>
				<height>50</height>
				<font>font37</font>
				<label>[B]WATCH[/B]HUB  [COLOR 80FFFFFF]/  $INFO[Container.FolderName][/COLOR]</label>
				<textcolor>FFFFFFFF</textcolor>
				<visible>String.IsEmpty(Container.PluginCategory)</visible>
			</control>
			<control type="label">
				<left>1420</left>
				<top>36</top>
				<width>400</width>
				<height>60</height>
				<align>right</align>
				<font>font45_title</font>
				<label>$INFO[System.Time]</label>
				<textcolor>FFFFFFFF</textcolor>
			</control>
			<control type="label">
				<left>1420</left>
				<top>96</top>
				<width>400</width>
				<height>30</height>
				<align>right</align>
				<font>font25_title</font>
				<label>$INFO[Container(600).CurrentItem] / $INFO[Container(600).NumItems]</label>
				<textcolor>B0FFFFFF</textcolor>
			</control>
			<!-- focused item -->
			<control type="group">
				<left>100</left>
				<top>120</top>
				<control type="image">
					<left>0</left>
					<top>0</top>
					<width>220</width>
					<height>70</height>
					<aspectratio align="left" aligny="center">keep</aspectratio>
					<fadetime>200</fadetime>
					<texture background="true">$INFO[Container(600).ListItem.Art(thumb)]</texture>
					<visible>!String.IsEqual(Container(600).ListItem.Property(kind),tile)</visible>
				</control>
				<control type="label">
					<left>0</left>
					<top>84</top>
					<width>1300</width>
					<height>50</height>
					<font>font45_title</font>
					<label>$INFO[Container(600).ListItem.Property(title)]</label>
					<textcolor>FFFFFFFF</textcolor>
					<visible>!String.IsEmpty(Container(600).ListItem.Property(title))</visible>
				</control>
				<control type="label">
					<left>0</left>
					<top>84</top>
					<width>1300</width>
					<height>50</height>
					<font>font45_title</font>
					<label>$INFO[Container(600).ListItem.Label]</label>
					<textcolor>FFFFFFFF</textcolor>
					<visible>String.IsEmpty(Container(600).ListItem.Property(title)) + !Container(600).ListItem.IsParentFolder</visible>
				</control>
				<control type="label">
					<left>0</left>
					<top>140</top>
					<width>1300</width>
					<height>36</height>
					<font>font27</font>
					<label>$INFO[Container(600).ListItem.Property(meta)]</label>
					<textcolor>FFB8C4D6</textcolor>
				</control>
			</control>
			<!-- grid -->
			<control type="panel" id="600">
				<visible>String.IsEqual(Container.PluginName,plugin.video.sportshub) + !Container.Content(movies)</visible>
				<left>84</left>
				<top>300</top>
				<width>1700</width>
				<height>780</height>
				<onleft>9000</onleft>
				<onright>600</onright>
				<onup>600</onup>
				<ondown>600</ondown>
				<viewtype label="Sports Hub">icon</viewtype>
				<preloaditems>2</preloaditems>
				<scrolltime tween="cubic" easing="out">300</scrolltime>
				<itemlayout width="416" height="312">
					<include content="SH_CardAny">
						<param name="focused" value="false"/>
					</include>
				</itemlayout>
				<focusedlayout width="416" height="312">
					<control type="group">
						<depth>DepthContentPopout</depth>
						<animation effect="zoom" start="100" end="106" time="160" tween="sine" easing="out" center="216,128">Focus</animation>
						<animation effect="zoom" start="106" end="100" time="160" tween="sine" easing="out" center="216,128">UnFocus</animation>
						<include content="SH_CardAny">
							<param name="focused" value="true"/>
						</include>
					</control>
				</focusedlayout>
			</control>
			<control type="scrollbar" id="631">
				<left>1800</left>
				<top>300</top>
				<width>8</width>
				<height>700</height>
				<onleft>600</onleft>
				<onright>600</onright>
				<showonepage>false</showonepage>
				<orientation>vertical</orientation>
				<visible>Control.IsVisible(600)</visible>
			</control>
		</control>
	</include>
</includes>
